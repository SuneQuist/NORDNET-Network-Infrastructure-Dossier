! Phase 4: additive new P2 uplink; preserve MPLS L3VPN/VRF/BGP/old core link
interface {{ router.backup_interface }}
 description CORE_TO_P2
 ip address {{ router.backup_address }} 255.255.255.252
 ip ospf {{ ospf_process }} area {{ ospf_area }}
 ip ospf network point-to-point
 ip ospf cost {{ p2_cost }}
 mpls ip
 no shutdown
 exit
router ospf {{ ospf_process }}
 no passive-interface {{ router.backup_interface }}
 exit
