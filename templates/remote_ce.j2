! Move previous Loopback10 simulated LAN to Gi0/1; preserve CE-PE BGP config
no interface Loopback10
interface GigabitEthernet0/1
 description CUSTOMER_LAN_{{ site }}
 ip address {{ gateway }} 255.255.255.0
 no shutdown
 exit
service timestamps log datetime msec
logging buffered 32768 informational
